{
  "name": "git-poseidon",
  "private": true,
  "version": "0.2.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "build:desktop": "tauri build --no-bundle",
    "test:git": "cargo test -p poseidon-core",
    "bindings": "cargo run -p poseidon-core --example export_types",
    "check:bindings": "cargo run -p poseidon-core --example export_types -- --check",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "format": "prettier --write src scripts index.html package.json tsconfig.json vite.config.ts svelte.config.js src-tauri/tauri.conf.json src-tauri/capabilities/main.json .prettierrc.json",
    "format:check": "prettier --check src scripts index.html package.json tsconfig.json vite.config.ts svelte.config.js src-tauri/tauri.conf.json src-tauri/capabilities/main.json .prettierrc.json",
    "test:graph": "node scripts/graph-smoke.mjs",
    "benchmark:graph": "cargo run --release -p poseidon-core --features bench --example graph_benchmark",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:arch": "node scripts/prepare-release.mjs --arch",
    "release:appimage": "tauri build --bundles appimage -- --locked",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tauri-apps/cli": "2.12.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "3.5.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "license": "MIT"
}
